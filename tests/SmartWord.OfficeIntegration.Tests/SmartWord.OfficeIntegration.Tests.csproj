<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\..\src\SmartWord.Application\SmartWord.Application.csproj" />
    <ProjectReference Include="..\..\src\SmartWord.Core\SmartWord.Core.csproj" />
    <ProjectReference Include="..\..\src\SmartWord.Infrastructure\SmartWord.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\SmartWord.OfficeIntegration\SmartWord.OfficeIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\SmartWord.AddIn\Resources\Prompts\*.md">
      <Link>Resources\Prompts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
